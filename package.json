{
  "name": "real-good-social-website",
  "version": "2.0.0",
  "private": true,
  "description": "Real Good Social — public website. React Router 7 (framework mode), prerendered to a static site served from S3 and CloudFront.",
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "react-router dev",
    "build": "react-router build && node ./scripts/finalise-static.mjs && node ./scripts/share-images.mjs",
    "preview": "vite preview",
    "typecheck": "react-router typegen && tsc",
    "clean": "rm -rf build .react-router"
  },
  "dependencies": {
    "@react-router/node": "^7.1.5",
    "isbot": "^5",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-router": "^7.1.5"
  },
  "devDependencies": {
    "@fontsource/inter": "^5.3.0",
    "@react-router/dev": "^7.1.5",
    "@resvg/resvg-js": "^2.6.2",
    "@types/node": "^20.14.0",
    "@types/react": "^18.3.3",
    "@types/react-dom": "^18.3.0",
    "satori": "^0.35.0",
    "typescript": "^5.7.0",
    "vite": "^5.4.11",
    "vite-tsconfig-paths": "^5.1.4"
  }
}
